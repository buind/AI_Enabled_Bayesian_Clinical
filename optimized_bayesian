import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

import pymc as pm
import arviz as az

from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_absolute_error, mean_squared_error

# ------------------------------
# 1. Reproducibility
# ------------------------------
np.random.seed(42)

# ------------------------------
# 2. Simulate ALS-like longitudinal data
# ------------------------------
n_patients = 40
months = np.arange(0, 7)

treatment = np.repeat([0, 1], n_patients // 2)
baseline = np.random.normal(40, 2, n_patients)

control_decline = np.random.normal(-1.0, 0.3, n_patients // 2)
treatment_decline = np.random.normal(-0.6, 0.3, n_patients // 2)
decline = np.concatenate([control_decline, treatment_decline])

rows = []

for i in range(n_patients):
    for m in months:
        score = baseline[i] + decline[i] * m + np.random.normal(0, 0.8)
        rows.append([i, m, treatment[i], score])

df = pd.DataFrame(
    rows, columns=["patient_id", "month", "treatment", "alsfrs"]
)

# ------------------------------
# 3. AI-based disease progression forecasting
# ------------------------------
forecast_rows = []

for pid in df.patient_id.unique():
    pdata = df[df.patient_id == pid]
    
    X = pdata[["month"]]
    y = pdata["alsfrs"]
    
    model = LinearRegression()
    model.fit(X, y)
    
    future = pd.DataFrame({"month": [7, 8, 9]})
    preds = model.predict(future)
    
    for m, p in zip(future["month"], preds):
        forecast_rows.append([pid, m, p])

forecast_df = pd.DataFrame(
    forecast_rows, columns=["patient_id", "month", "predicted_alsfrs"]
)

# ------------------------------
# 4. Forecasting performance metrics (backtest)
# ------------------------------
y_true, y_pred = [], []

for pid in df.patient_id.unique():
    pdata = df[df.patient_id == pid]
    train = pdata[pdata.month <= 4]
    test = pdata[pdata.month == 5]
    
    if len(test) == 0:
        continue
    
    model = LinearRegression()
    model.fit(train[["month"]], train["alsfrs"])
    
    pred = model.predict(pd.DataFrame({"month": [5]}))[0]
    
    y_true.append(test["alsfrs"].values[0])
    y_pred.append(pred)

mae = mean_absolute_error(y_true, y_pred)
rmse = mean_squared_error(y_true, y_pred, squared=False)

print(f"Forecast MAE: {mae:.2f}")
print(f"Forecast RMSE: {rmse:.2f}")

# ------------------------------
# 5. Prepare final outcomes for Bayesian analysis
# ------------------------------
final_scores = (
    df[df.month == 6]
    .groupby("patient_id")
    .last()
    .reset_index()
)

# ------------------------------
# 6. Bayesian adaptive model (Variational Inference)
# ------------------------------
with pm.Model() as bayes_model:
    
    mu_control = pm.Normal("mu_control", mu=30, sigma=10)
    mu_treat = pm.Normal("mu_treat", mu=30, sigma=10)
    
    sigma = pm.HalfNormal("sigma", sigma=5)
    
    mu = pm.math.switch(
        final_scores.treatment.values,
        mu_treat,
        mu_control
    )
    
    y_obs = pm.Normal(
        "y_obs",
        mu=mu,
        sigma=sigma,
        observed=final_scores.alsfrs.values
    )
    
    delta = pm.Deterministic("delta", mu_treat - mu_control)
    
    approx = pm.fit(
        n=30000,
        method="advi",
        random_seed=42
    )
    
    trace = approx.sample(5000)

# ------------------------------
# 7. Adaptive decision metrics
# ------------------------------
delta_samples = trace.posterior["delta"].values.flatten()

clin_threshold = 2.0

prob_superiority = np.mean(delta_samples > 0)
prob_clinical = np.mean(delta_samples > clin_threshold)

print(f"P(Treatment > Control): {prob_superiority:.3f}")
print(f"P(Clinically Meaningful Effect): {prob_clinical:.3f}")

if prob_clinical > 0.95:
    decision = "Early Stop for Success"
elif prob_superiority < 0.20:
    decision = "Stop for Futility"
else:
    decision = "Continue Trial"

print("Adaptive Decision:", decision)

# ------------------------------
# 8. FIGURES
# ------------------------------

# Figure 1: Mean disease trajectories
plt.figure(figsize=(8,5))
sns.lineplot(
    data=df,
    x="month",
    y="alsfrs",
    hue="treatment",
    estimator="mean",
    ci=95
)
plt.title("Mean ALSFRS-R Trajectories by Treatment Arm")
plt.xlabel("Month")
plt.ylabel("ALSFRS-R Score")
plt.show()

# Figure 2: Posterior treatment effect
plt.figure(figsize=(7,4))
sns.kdeplot(delta_samples, fill=True)
plt.axvline(0, linestyle="--", color="black")
plt.axvline(clin_threshold, linestyle="--", color="red")
plt.title("Posterior Distribution of Treatment Effect")
plt.xlabel("Δ ALSFRS-R (Treatment – Control)")
plt.show()

# Figure 3: Observed vs forecasted trajectories (sample patients)
sample_ids = np.random.choice(df.patient_id.unique(), 3, replace=False)

plt.figure(figsize=(8,5))
for pid in sample_ids:
    obs = df[df.patient_id == pid]
    pred = forecast_df[forecast_df.patient_id == pid]
    
    plt.plot(obs.month, obs.alsfrs, marker="o")
    plt.plot(pred.month, pred.predicted_alsfrs, linestyle="--")

plt.title("Observed vs AI-Forecasted Disease Progression")
plt.xlabel("Month")
plt.ylabel("ALSFRS-R")
plt.show()
